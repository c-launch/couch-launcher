{
  "name": "couch-launcher",
  "productName": "Couch Launcher",
  "version": "1.14.3",
  "description": "A controller-first, console-style game launcher for Windows.",
  "main": "src/boot.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --windowed",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.couchlauncher",
    "productName": "Couch Launcher",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Couch Launcher",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "CouchLauncher-Setup-${version}.${ext}"
    },
    "npmRebuild": false,
    "directories": {
      "buildResources": "build",
      "output": "dist"
    }
  },
  "author": "Jahdiel"
}
